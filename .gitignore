# ======================================================================
# .gitignore —— 告诉 Git「哪些文件不用管、不要上传」
# 本文件由课程作品集模板自动生成
# 语法：一行写一个规则；# 开头的是注释
# ======================================================================

# ---------- 操作系统自动生成的文件 ----------
.DS_Store            # macOS 桌面文件夹的缓存
Thumbs.db            # Windows 缩略图缓存
desktop.ini          # Windows 文件夹配置
$RECYCLE.BIN/        # Windows 回收站

# ---------- 编辑器 / IDE 的个人配置 ----------
.vscode/             # VS Code 的个人设置（不含团队共享配置）
.idea/               # JetBrains 系列（PyCharm / IDEA）配置
*.swp                # Vim 临时文件
*~                   # 各种编辑器备份文件

# ---------- 日志与临时文件 ----------
*.log                # 运行日志
*.tmp                # 临时文件
*.bak                # 备份文件
*.cache              # 缓存文件

# ---------- 数据库相关文件 ----------
# 注意：真实的数据库文件通常体积大且含隐私数据，不建议上传
*.db                 # 通用数据库文件
*.sqlite             # SQLite 数据库
*.sqlite3            # SQLite 数据库
*.mdb                # Access 数据库
*.accdb              # Access 数据库
*.frm                # MySQL 表结构文件
*.ibd                # MySQL InnoDB 数据文件
*.myd                # MySQL MyISAM 数据文件
*.myi                # MySQL MyISAM 索引文件
*.ldf                # SQL Server 日志文件
*.mdf                # SQL Server 主数据文件

# ---------- Python 项目 ----------
__pycache__/         # Python 字节码缓存
*.py[cod]            # 编译后的 Python 文件
.venv/               # 虚拟环境
venv/                # 虚拟环境
env/                 # 虚拟环境
*.egg-info/          # 打包生成的元数据
.pytest_cache/       # 测试缓存

# ---------- Java / Maven 项目 ----------
*.class              # 编译后的字节码
target/              # Maven 构建产物
build/               # Gradle 构建产物

# ---------- Node.js / 前端项目 ----------
node_modules/        # 第三方依赖包（体积巨大，永不手动上传）
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/                # 前端打包产物

# ---------- C / C++ 项目 ----------
*.o                  # 编译中间文件
*.obj                # 编译中间文件
*.exe                # 可执行程序
*.out                # 可执行程序

# ---------- 环境变量与密钥（重要！防泄露） ----------
.env                 # 环境变量文件（常含密码）
.env.local
*.pem                # 证书私钥
*.key                # 密钥文件
